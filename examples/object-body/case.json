{
  "version": 1,
  "name": "Two render requests preserve object options",
  "input": {
    "node": "Fixture",
    "items": [
      {
        "shortId": 42,
        "styling": {
          "color": "#112233",
          "fontSize": 31
        }
      },
      {
        "shortId": 43,
        "styling": {
          "color": "#aabbcc",
          "fontSize": 47
        }
      }
    ]
  },
  "mocks": [
    {
      "node": "Render",
      "url": "/renders",
      "routes": [
        {
          "method": "POST",
          "path": "/renders",
          "responses": [
            {
              "status": 200,
              "json": {
                "id": "render-42"
              }
            },
            {
              "status": 200,
              "json": {
                "id": "render-43"
              }
            }
          ],
          "expect": {
            "count": 2,
            "bodies": [
              {
                "shortId": 42,
                "renderOptions": {
                  "color": "#112233",
                  "fontSize": 31
                }
              },
              {
                "shortId": 43,
                "renderOptions": {
                  "color": "#aabbcc",
                  "fontSize": 47
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "assertions": [
    {
      "node": "Render",
      "equals": [
        {
          "id": "render-42"
        },
        {
          "id": "render-43"
        }
      ]
    }
  ]
}
