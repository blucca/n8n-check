{
  "name": "Object body example",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fixture",
      "name": "Fixture",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -200,
        0
      ],
      "parameters": {}
    },
    {
      "id": "render",
      "name": "Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.example.com/renders",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { shortId: $json.shortId, renderOptions: $json.styling } }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Fixture",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fixture": {
      "main": [
        [
          {
            "node": "Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
