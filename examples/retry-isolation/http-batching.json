{
  "name": "HTTP batching 1 with node retry",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fixture",
      "name": "Fixture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "jsCode": "return [\n  {\n    \"shortId\": 42,\n    \"styling\": {\n      \"color\": \"#112233\",\n      \"fontSize\": 31\n    }\n  },\n  {\n    \"shortId\": 43,\n    \"styling\": {\n      \"color\": \"#aabbcc\",\n      \"fontSize\": 47\n    }\n  }\n].map(json => ({ json }));"
      }
    },
    {
      "id": "render",
      "name": "Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.example.com/renders/{{ $json.shortId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { shortId: $json.shortId, renderOptions: $json.styling } }}",
        "options": {
          "timeout": 10000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        420,
        0
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Fixture",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fixture": {
      "main": [
        [
          {
            "node": "Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
