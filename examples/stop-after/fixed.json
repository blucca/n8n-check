        }
      },
      {
        "json": {
          "invoiceId": "INV-43",
          "text": "Invoice INV-43: $120.50"
        }
      }
    ]
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "active": false
}
