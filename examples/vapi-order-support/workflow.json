    {
      "id": "split-tool-calls",
      "name": "Split tool calls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message = $input.first().json.body?.message;\nif (message?.type !== 'tool-calls' || !Array.isArray(message.toolCallList) || message.toolCallList.length === 0) throw new Error('Expected a non-empty Vapi tool-calls message.');\nconst ids = new Set();\nreturn message.toolCallList.map(call => {\n  if (typeof call.id !== 'string' || !call.id || ids.has(call.id)) throw new Error('Tool call IDs must be present and unique.');\n  ids.add(call.id);\n  return {json:{toolCallId:call.id,callId:message.call?.id ?? '',toolName:call.function?.name ?? '',arguments:call.function?.arguments},pairedItem:{item:0}};\n});"
      }
    },
    {
      "id": "each-tool-call",
      "name": "Each tool call",
      "type": "n8n-nodes-base.splitInBatches",
