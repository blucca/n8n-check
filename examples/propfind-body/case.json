{
  "version": 1,
  "name": "Issue 39395 - PROPFIND transmits its XML body",
  "input": {
    "node": "Code in JavaScript",
    "items": [
      {
        "nextcloudInstance": "example.invalid",
        "userId": "user_id",
        "auth": "Basic synthetic-placeholder",
        "webDavPath": "fixture"
      }
    ]
  },
  "mocks": [
    {
      "node": "HTTP Request",
      "url": "/dav",
      "routes": [
        {
          "method": "PROPFIND",
          "path": "/dav",
          "responses": [
            {
              "status": 200,
              "json": {
                "received": true
