          "position": [
            -200,
            0
          ],
          "parameters": {
            "mode": "runOnceForAllItems",
            "jsCode": "return $input.all();"
          }
        },
        {
          "id": "select",
          "name": "Select rows",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [
            0,
            0
