            "jsCode": "return [{\"id\": \"policy-01\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-02\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-03\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-04\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-05\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-06\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-07\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"policy-08\", \"score\": 0.9, \"source\": \"current-index\"}, {\"id\": \"distractor-09\", \"score\": 0.2, \"source\": \"current-index\"}] .map(json => ({json}));"
          }
