            "version": 2
          },
          "conditions": [
            {
              "id": "contract",
              "leftValue": "={{ $('Expected').first().json.expected_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        800,
        200
      ]
    },
    {
      "id": "Legitimately empty",
      "name": "Legitimately empty",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"outcome\":\"legitimately_empty\",\"expected_count\":0,\"written_count\":0}",
        "options": {}
      },
      "position": [
        1000,
        150
      ]
    },
    {
      "id": "Incomplete empty",
      "name": "Incomplete empty",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'incomplete: expected ' + $('Expected').first().json.expected_count + ' write, received zero records' }}"
      },
      "position": [
        1000,
        300
      ]
    }
