# Shared synthetic local demo. Use your own authentication for private exports.
AUTH_DISABLED=true
AGENT_USER_EMAIL=dev@local.test
APP_NAME=traceglass
# Optional in-app free agent. Keep this key on the server.
# OPENROUTER_API_KEY=
# Only this application's tools and shared state are needed.
AGENT_NATIVE_DISABLED_PLUGINS=terminal,integrations,observational-memory,onboarding,resources,context-xray
# Production: persistent PostgreSQL for native shared state and agent history.
# DATABASE_URL=postgresql://traceglass:YOUR_PASSWORD@127.0.0.1:15436/traceglass
# BETTER_AUTH_SECRET=YOUR_RANDOM_SERVER_SECRET
# HOST=127.0.0.1
# PORT=8100
