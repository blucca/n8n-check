{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "noEmit": true,
    "skipLibCheck": true, "strict": true, "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["app", "actions", "server", "vite.config.ts", "agent-native.config.ts", ".generated/action-types.d.ts"]
}
